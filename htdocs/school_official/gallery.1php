<?php
include("dbcon.php");


$tab_query = "SELECT * FROM gallery_cat ORDER BY gc_id ASC";
$tab_result = mysqli_query($con,$tab_query);
$tab_menu = '';
$tab_content = '';
$i = 0;
while($row = mysqli_fetch_array($tab_result))
{
    if($i == 0)
    {
    $tab_menu .= '<li class="active"><a href="#'.$row["gc_id"].'" data-toggle="tab">'.$row["gallery_cat_name"].'</a></li>';
    $tab_content .= '<div id="'.$row["gc_id"].'" class="tab-pane  in active">';
    }
    else
    {
    $tab_menu .= '<li><a href="#'.$row["gc_id"].'" data-toggle="tab">'.$row["gallery_cat_name"].'</a></li>';
    $tab_content .= '<div id="'.$row["gc_id"].'" class="tab-pane ">';
    }

$product_query = "SELECT * FROM slider WHERE gcategory = '".$row["gc_id"]."'";
$product_result = mysqli_query($con,$product_query);

while($sub_row = mysqli_fetch_array($product_result))
 {
  $tab_content .= '<div class="col-lg-3 col-md-12 mb-4" style="float: left;">

                        <div class="overlay z-depth-1-half">
                            <a class="fancybox-buttons" data-fancybox-group="button" href="admin/gallery/'.$sub_row['admin_image'].'"><img src="admin/gallery/'.$sub_row['admin_image'].'" class="img-fluid" alt=""></a>
                            <div class="mask rgba-white-slight"></div>
                        </div>                       

                    </div>';
 }
 $tab_content .= '<div style="clear:both"></div></div>';
 $i++;
}

?> 


